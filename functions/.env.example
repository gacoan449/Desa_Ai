# Copy to functions/.env locally; never commit real values.
PORT=8080
# Public HTTPS URL of this Express API; used as the TriPay callback URL.
PUBLIC_API_BASE_URL=https://api.example.com
# Comma-separated exact web origins. Leave blank for native Android-only requests.
ALLOWED_ORIGINS=
# Firebase project ID; Firebase Admin SDK uses Application Default Credentials.
GOOGLE_CLOUD_PROJECT=replace-with-your-firebase-project-id
# Path to a service-account JSON file stored OUTSIDE the repository.
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/firebase-service-account.json
OPENAI_API_KEY=
TRIPAY_API_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_PRIVATE_KEY=
TRIPAY_SANDBOX=true
# Random long secret used by cron to call POST /_internal/reconcile.
CRON_SECRET=
